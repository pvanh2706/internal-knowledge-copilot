{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "AssumableOnlyByTheNamedPersonWithMfa",
      "Effect": "Allow",
      "Principal": { "AWS": "${PersonPrincipalArn}" },
      "Action": ["sts:AssumeRole"],
      "Condition": {
        "Bool": { "aws:MultiFactorAuthPresent": "true" },
        "NumericLessThan": { "aws:MultiFactorAuthAge": "900" }
      }
    }
  ]
}
