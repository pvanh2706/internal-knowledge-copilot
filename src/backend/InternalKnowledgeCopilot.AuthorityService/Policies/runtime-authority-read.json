{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "RuntimeReadsOwnDeploymentRecordOnly",
      "Effect": "Allow",
      "Action": ["dynamodb:GetItem"],
      "Resource": ["arn:aws:dynamodb:${Region}:${AccountId}:table/${TableName}"],
      "Condition": {
        "ForAllValues:StringEquals": { "dynamodb:LeadingKeys": ["deployment#${DeploymentId}"] }
      }
    },
    {
      "Sid": "RuntimeNeverWritesOrInvokesAuthority",
      "Effect": "Deny",
      "Action": [
        "dynamodb:PutItem", "dynamodb:UpdateItem", "dynamodb:DeleteItem", "dynamodb:BatchWriteItem",
        "dynamodb:ConditionCheckItem", "dynamodb:PartiQLInsert", "dynamodb:PartiQLUpdate", "dynamodb:PartiQLDelete",
        "dynamodb:Scan", "dynamodb:Query", "dynamodb:BatchGetItem",
        "dynamodb:CreateTable", "dynamodb:DeleteTable", "dynamodb:UpdateTable", "dynamodb:RestoreTableToPointInTime",
        "execute-api:Invoke", "lambda:InvokeFunction"
      ],
      "Resource": ["*"]
    }
  ]
}
