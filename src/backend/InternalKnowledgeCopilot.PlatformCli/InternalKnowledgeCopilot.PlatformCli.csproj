<Project Sdk="Microsoft.NET.Sdk">

  <!-- S01-C: CLI operator riêng cho bootstrap/recovery Platform Admin. Không dùng Web SDK, không dựng WebApplication/host,
       nên không có HTTP endpoint, middleware, migration hay background worker nào chạy cùng CLI. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <!-- OperatorProfile dạng assume-role có MFA (role_arn/source_profile/mfa_serial); CLI tự đặt MfaTokenCodeCallback (C-IR-02). -->
    <PackageReference Include="AWSSDK.SecurityToken" Version="4.0.100" />
  </ItemGroup>

  <ItemGroup>
    <!-- Test gọi trực tiếp bước transaction SQLite để kiểm tra phòng thủ chiều sâu khi authority hoạt động sai. -->
    <InternalsVisibleTo Include="InternalKnowledgeCopilot.Tests" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\InternalKnowledgeCopilot.Api\InternalKnowledgeCopilot.Api.csproj" />
  </ItemGroup>

</Project>
